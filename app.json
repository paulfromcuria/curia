{
  "expo": {
    "name": "Curia",
    "slug": "paulfromcuria",
    "scheme": "curia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0A09",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paulfromcuria.curia",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Curia uses your location to center the map and rank venues near you."
      }
    },
    "android": {
      "package": "com.paulfromcuria.curia",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "654d6d1f-cdd7-4df1-921f-6bc6a99716c2"
      }
    },
    "owner": "paulfromcurias-team"
  }
}
