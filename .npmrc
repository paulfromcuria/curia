# @rnmapbox/maps peer-depends on mapbox-gl@^2.9.0 (its native-build peer),
# but this project also uses mapbox-gl@^3.x directly for the web build's
# real basemap (src/lib/map/, TownMap.tsx-equivalent) — the two are used on
# different platforms in practice, so the conflict is real but harmless.
# Without this, a plain `npm install` fails outright (ERESOLVE), including
# on Vercel's build.
legacy-peer-deps=true
