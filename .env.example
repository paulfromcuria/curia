# Copy to .env (gitignored) and fill in real values. Never commit .env itself.

# Mapbox public access token (starts with pk.) — from your Mapbox account's
# Tokens page (https://account.mapbox.com/access-tokens/). Used at runtime by
# @rnmapbox/maps via src/lib/map/mapbox-config.ts.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Android builds only: a SEPARATE secret Mapbox token (starts with sk.) with
# the "Downloads:Read" scope, used by the Gradle build to fetch the Mapbox
# Android SDK from Mapbox's private Maven repo. This is NOT the same as the
# public token above and must never be exposed client-side (it's a build-time
# credential, not read by the app itself). Set as MAPBOX_DOWNLOADS_TOKEN in
# EAS Build's environment variables / secrets, not here, if you need Android.
