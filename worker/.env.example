# Copy to .env (gitignored) and fill in real values. Never commit .env
# itself. Unprefixed throughout — this is a server-side-only service, none
# of this is ever bundled into client JS (matches the main app's own
# convention: EXPO_PUBLIC_ only for client-bundle-safe values, see its own
# .env.example).

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys.
# Every pipeline stage (discover/verify/copy/voice-qa/gate-check/audit)
# calls the Messages API with this key.
ANTHROPIC_API_KEY=

# Which model every stage uses. claude-sonnet-5 for every stage is the
# deliberate first-pass choice (2026-09-16) — mixing in a cheaper model
# before there's real per-candidate cost data from a dry run to optimize
# against would be premature.
CURATOR_MODEL=claude-sonnet-5

# Supabase project URL + SERVICE ROLE key (not the anon key — this worker
# needs to write to venue_candidates/district_candidates/worker_runs, and
# those tables' RLS grants service_role only, same idiom as admin_users —
# see supabase/migrations/0010_growth_engine.sql). Project Settings > API
# in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Both default to keeping this worker inert — see each var's own comment
# in src/config.ts for exactly what each one gates. Neither should be
# flipped to a live-production combination (CURATOR_ENABLED=true,
# CURATOR_DRY_RUN=false) without reviewing at least one real dry-run
# digest first.
CURATOR_ENABLED=false
CURATOR_DRY_RUN=true
DRY_RUN_CANDIDATE_COUNT=10
DRY_RUN_DISTRICT=mobberley

# Real pacing knobs for CURATOR_ENABLED=true runs — see markets.yaml's own
# header comment for why the daily budget/target, not district scarcity,
# is what actually paces expansion right now.
DAILY_USD_BUDGET=40
DAILY_CANDIDATE_TARGET=400

# Promotion cron only (run-promotion.ts) — a deploy key with push access
# to this repo, used to commit scripts/export-db-to-json.mjs's output to
# DATA_EXPORTS_BRANCH after promoting approved candidates. Not needed for
# the discovery cron. Generate a dedicated deploy key (not your personal
# SSH key) scoped to this one repo, and point this at its file path in the
# Railway environment (or mount it as a Railway secret file).
GIT_DEPLOY_KEY_PATH=
DATA_EXPORTS_BRANCH=data-exports
